{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "response_id",
    "opening_id",
    "prelude",
    "natal_placements",
    "pre_seal_sections",
    "personal_seal",
    "main_life_sections",
    "first_calibration",
    "special_contributions",
    "second_calibration",
    "return_identity",
    "validation_metadata"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["gm.natal.v1"] },
    "response_id": { "type": "string", "enum": ["initial_natal"] },
    "opening_id": { "type": "string", "enum": ["natal_first_pass"] },
    "prelude": { "$ref": "#/$defs/prelude" },
    "natal_placements": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/placement" }
    },
    "pre_seal_sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/section" }
    },
    "personal_seal": { "$ref": "#/$defs/personalSeal" },
    "main_life_sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/section" }
    },
    "first_calibration": { "$ref": "#/$defs/firstCalibration" },
    "special_contributions": {
      "type": "array",
      "maxItems": 11,
      "items": { "$ref": "#/$defs/specialContribution" }
    },
    "second_calibration": { "$ref": "#/$defs/secondCalibration" },
    "return_identity": { "type": "string", "enum": ["return_to_user_intent"] },
    "validation_metadata": { "$ref": "#/$defs/validationMetadata" }
  },
  "$defs": {
    "prelude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "included", "body_paragraphs", "hat_evidence_refs"],
      "properties": {
        "section_id": { "type": "string", "enum": ["ayin_gokyuzu_haritasi"] },
        "included": { "type": "boolean" },
        "body_paragraphs": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 1200 } },
        "hat_evidence_refs": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 96 } }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "sign", "degree", "house", "retrograde", "evidence_id"],
      "properties": {
        "point_id": {
          "type": "string",
          "enum": ["sun", "moon", "ascendant", "mercury", "venus", "mars", "jupiter", "saturn", "uranus", "neptune", "pluto", "north_node", "mc"]
        },
        "sign": { "type": "string", "minLength": 1, "maxLength": 48 },
        "degree": { "type": "string", "minLength": 1, "maxLength": 32 },
        "house": { "type": "string", "maxLength": 32 },
        "retrograde": { "type": "boolean" },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "included", "body_paragraphs", "hat_evidence_refs"],
      "properties": {
        "section_id": {
          "type": "string",
          "enum": ["profilin", "haritanin_ozu", "element_dengen", "sinerji", "senin_yolun", "para_kariyer", "iliskiler", "aile", "karmalar"]
        },
        "included": { "type": "boolean" },
        "body_paragraphs": { "type": "array", "maxItems": 14, "items": { "type": "string", "maxLength": 1600 } },
        "hat_evidence_refs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 96 } }
      }
    },
    "personalSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seal_id", "included", "motto", "evidence_refs"],
      "properties": {
        "seal_id": { "type": "string", "enum": ["sun_asc_personal_seal"] },
        "included": { "type": "boolean", "enum": [true] },
        "motto": { "type": "string", "minLength": 1, "maxLength": 320 },
        "evidence_refs": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 96 } }
      }
    },
    "specialContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_id", "body_paragraphs", "evidence_refs"],
      "properties": {
        "contribution_id": {
          "type": "string",
          "enum": ["hellenistic", "jyotish", "esoteric", "sade_sati", "rahu_ketu", "retrogrades", "lilith", "chiron", "vertex", "part_of_fortune", "fixed_stars"]
        },
        "body_paragraphs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 1200 } },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 96 } }
      }
    },
    "firstCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_id", "required"],
      "properties": {
        "calibration_id": { "type": "string", "enum": ["main_life_areas"] },
        "required": { "type": "boolean", "enum": [true] }
      }
    },
    "secondCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_id", "required"],
      "properties": {
        "calibration_id": { "type": "string", "enum": ["general_natal"] },
        "required": { "type": "boolean", "enum": [true] }
      }
    },
    "validationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "evidence_policy", "visible_markup_owner"],
      "properties": {
        "schema_id": { "type": "string", "enum": ["gm_natal_semantic_v1"] },
        "schema_version": { "type": "string", "enum": ["1.0.0"] },
        "evidence_policy": { "type": "string", "enum": ["verified_only"] },
        "visible_markup_owner": { "type": "string", "enum": ["m1a3_deterministic_renderer"] }
      }
    }
  }
}
